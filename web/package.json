{
  "name": "suenmoney-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SuenMoney 前端 —— Web 与移动端共用同一份代码（移动端由 Capacitor 包壳）",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node ../scripts/node-run.mjs --test",
    "typecheck": "vue-tsc --noEmit",
    "cap": "cap",
    "cap:sync": "npm run build && cap sync",
    "android:sync": "npm run build && cap sync android",
    "ios:sync": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource-variable/outfit": "^5.1.1",
    "@lucide/vue": "^1.48.0",
    "misans": "^5.0.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@fontsource/outfit": "^5.1.0",
    "@rollup/rollup-linux-x64-gnu": "^4.63.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
