#!/bin/bash
# 卸载后：再停一次（幂等兜底），端口还被占就写日志警告；恒 exit 0。
set -o pipefail
cd "$(dirname "$0")" || exit 0
./main stop
if timeout 2 bash -c "exec 3<>/dev/tcp/127.0.0.1/5310" 2>/dev/null; then
    VAR="${TRIM_PKGVAR:-$(cd .. && pwd)/var}"
    echo "[WARN] 卸载后端口 5310 仍被占用" >> "${VAR}/info.log" 2>/dev/null
fi
exit 0
