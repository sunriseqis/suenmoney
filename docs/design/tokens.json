  "dimensions": {
    "$meta": {
      "desc": "多维色块体系（2026-10-21 用户新增）：构成条可按不同维度切换配色，每个维度一套固定色带，语义不许混用",
      "rule": "同一屏只渲染一个维度的色带；切换维度 = 换一排色块，不叠加"
    },
    "category": {
      "desc": "分类维度（默认）：用 chart 16 槽，用户自定义色"
