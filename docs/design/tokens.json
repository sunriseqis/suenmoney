      "file": "docs/design/brand/mark-header.svg",
      "minSize": "48px",
      "desc": "带 header 条与薄荷状态点，<48px 自动隐藏"
    },
    "plate": {
      "value": "#141222"
    },
    "card": {
      "value": "#1E1D2E"
    },
    "empty": {
      "value": "#282740",
      "desc": "空格的填充"
    },
    "safeArea": {
      "value": "0.78",
      "desc": "字形不越出中心 78%（网格 796/1024）"
    }
  },
