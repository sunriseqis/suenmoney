{
  "$schema": "https://design-tokens.org/draft",
  "$meta": {
    "name": "SuenMoney v3 · 夜间霓虹 M3",
    "version": "3.0.0",
    "date": "2026-10-21",
    "status": "定稿",
    "note": "唯一真相源。生成 web/src/styles/tokens.generated.css / DesignTokens.swift / Tokens.ets —— 三端不许各写各的数字。",
    "supersedes": "flat-design.md（零阴影 / 6–8px 圆角 / 分区用色块）",
    "source": [
      "docs/design/suenmoney-v3-design-system.md",
      "docs/design/v3-neon-m3.html（静态样张）"
    ]
  },
  "color": {
    "surface": {
      "base": {
        "value": "#141222",
        "desc": "页面底"
      },
      "container": {
        "value": "#1E1D2E",
        "desc": "卡片底"
      },
      "high": {
        "value": "#282740",
        "desc": "浮层 / 底栏 / 空轨道 / 空格"
      },
      "lowest": {
        "value": "#0B0A10",
        "desc": "仅用于页面外框（演示页），应用内不用"
      }
    },
    "on": {
      "surface": {
        "value": "#F2EFFA",
        "contrastOnBase": 16.24,
        "desc": "正文 / 大数字"
      },
      "surfaceVariant": {
        "value": "#B9B5CC",
        "contrastOnBase": 9.25,
        "desc": "次级文字 / 辅助标签"
      }
    },
    "outline": {
      "default": {
        "value": "#3A3852",
        "contrastOnBase": 1.64,
        "usage": "分隔线（装饰性）"
      },
      "strong": {
        "value": "#706D96",
        "contrastOnContainer": 3.4,
        "usage": "可交互控件边界（输入框/分段控件/开关），WCAG 1.4.11"
      }
    },
    "accent": {
      "primary": {
        "value": "#B388FF",
        "on": "#2A1065",
        "container": "rgba(179,136,255,0.12)",
        "contrastOnBase": 6.92,
        "role": "交互 / 选中 / 焦点外的强调图形"
      },
      "secondary": {
        "value": "#4DFFD2",
        "on": "#00352E",
        "container": "rgba(77,255,210,0.12)",
        "contrastOnBase": 14.53,
        "role": "「钱回来了」：退款 / 冲销 / 支出下降"
      },
      "tertiary": {
        "value": "#FF7AB8",
        "on": "#5F1606",
        "container": "rgba(255,122,184,0.12)",
        "contrastOnBase": 7.66,
        "role": "「要多花了 / 该处理了」：支出涨幅 / 逾期 / FAB"
      },
      "lemon": {
        "value": "#E5FF41",
        "on": "#3F2E00",
        "container": "rgba(229,255,65,0.12)",
        "contrastOnBase": 16.42,
        "role": "进度：计划还款 / 累计条填充（永远伴随数字）"
      },
      "blue": {
        "value": "#5DB8FF",
        "on": "#00344F",
        "container": "rgba(93,184,255,0.12)",
        "contrastOnBase": 8.57,
        "role": "信息 / 链接 / 焦点环"
      }
    },
    "stateLayer": {
      "hover": {
        "value": "0.08",
        "desc": "叠该组件自身主色，8%"
      },
      "pressed": {
        "value": "0.12",
        "desc": "叠该组件自身主色，12%"
      },
      "focus": {
        "value": "#5DB8FF",
        "width": "2px",
        "offset": "2px"
      }
    },
    "scrim": {
      "value": "rgb(20 18 34 / 0.42)",
      "desc": "遮罩（深色）"
    }
  },
  "shape": {
    "card": {
      "value": "24px"
    },
    "sheet": {
      "value": "24px",
      "desc": "底部抽屉顶部圆角"
    },
    "field": {
      "value": "14px"
    },
    "fab": {
      "value": "28px"
    },
    "pill": {
      "value": "999px"
    },
    "keypad": {
      "value": "18px"
    },
    "avatar": {
      "value": "50%"
    }
  },
  "elevation": {
    "level0": {
      "value": "none",
      "desc": "surface 上的静态区块"
    },
    "level1": {
      "value": "0 2px 8px rgba(0,0,0,0.35)",
      "desc": "卡片"
    },
    "level2": {
      "value": "0 8px 24px rgba(0,0,0,0.45)",
      "desc": "FAB / 抽屉 / 对话框"
    }
  },
  "typography": {
    "family": {
      "value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "note": "数字与拉丁沿用 Outfit Variable（与旧系统一致），中文回落 MiSans VF；后端/原生端各取本地等价字体"
    },
    "numeric": {
      "value": "tabular-nums",
      "desc": "所有金额与统计数字，无例外"
    },
    "scale": {
      "display": {
        "size": "48px",
        "weight": 500,
        "tracking": "-0.02em",
        "usage": "本期支出（hero 大数字）"
      },
      "displaySm": {
        "size": "40px",
        "weight": 500,
        "tracking": "-0.02em",
        "usage": "移动端 hero"
      },
      "h1": {
        "size": "32px",
        "weight": 500,
        "usage": "页面大标题"
      },
      "h2": {
        "size": "16px",
        "weight": 500,
        "usage": "卡片标题"
      },
      "body": {
        "size": "15px",
        "weight": 400,
        "usage": "流水商户名 / 正文"
      },
      "bodySm": {
        "size": "13px",
        "weight": 400,
        "usage": "次级说明"
      },
      "label": {
        "size": "11px",
        "weight": 500,
        "tracking": "0.5px",
        "case": "uppercase",
        "usage": "辅助标签 / 表格头"
      }
    }
  },
  "motion": {
    "easing": {
      "value": "cubic-bezier(0.2, 0, 0, 1)",
      "desc": "M3 emphasized，全站唯一曲线"
    },
    "durationFast": {
      "value": "200ms",
      "usage": "状态层 / hover"
    },
    "durationMid": {
      "value": "350ms",
      "usage": "卡片入场（淡入 + 上移 8px）"
    },
    "durationSlow": {
      "value": "400ms",
      "usage": "进度条 / 数字变化"
    },
    "reducedMotion": {
      "value": "respect-prefers-reduced-motion",
      "desc": "入场与 count-up 直接落到终态"
    }
  },
  "layout": {
    "grid": {
      "value": "8px",
      "desc": "间距栅格基数"
    },
    "cardPadding": {
      "value": "24px",
      "compact": "18px"
    },
    "cardGap": {
      "value": "16px",
      "compact": "12px"
    },
    "contentMax": {
      "value": "1200px"
    },
    "mobileWidth": {
      "value": "390px"
    },
    "rowHeight": {
      "value": "64px",
      "desc": "流水行"
    },
    "avatar": {
      "value": "44px",
      "desc": "流水行左侧分类徽位"
    },
    "fab": {
      "value": "56px",
      "inset": "24px"
    }
  },
  "brand": {
    "master": {
      "file": "docs/design/brand/mark.svg",
      "minSize": "32px",
      "desc": "1024² 方形母版，11 亮格 S + 9 空格"
