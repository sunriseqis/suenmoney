# ============================================================================
#  产物与运行时数据一律不入库。
#  产物类型新增时，必须同步在 docs/conventions.md 的产物表里补一行。
# ============================================================================

# ---- 依赖 ----
node_modules/
# 仓库根无 dependencies，前后端各自用子目录 lock，根锁不入库
/package-lock.json

# ---- server：没有构建步骤，只有运行时数据 ----
server/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ---- web：Vite 生产构建产物 ----
web/dist/
web/.vite/
web/coverage/

# ---- android：Gradle 与打包产物 ----
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/local.properties
android/**/*.apk
android/**/*.aab
/app/

# ---- ios：Xcode 与打包产物 ----
ios/App/build/
ios/App/Pods/
ios/**/*.xcworkspace/xcuserdata/
# SPM 迷你 workspace 索引由 Xcode 打开时自动生成，不入库；
# 但 xcshareddata/swiftpm/Package.resolved（iOS 依赖锁）必须跟踪，别整目录忽略
ios/**/*.xcworkspace/contents.xcworkspacedata
ios/**/*.xcodeproj/xcuserdata/
ios/**/*.ipa
ios/**/*.xcarchive
ios/App/App/public/

# ---- 通用 ----
*.log
.DS_Store

# ---- 本地环境变量 ----
.env
.env.local

# ---- 私人账单导出（根目录，含隐私不入库） ----
/*.csv
