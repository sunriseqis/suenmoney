# ============================================================================
#  产物与运行时数据一律不入库。
#  产物类型新增时，必须同步在 docs/conventions.md 的产物表里补一行。
# ============================================================================

# ---- 依赖 ----
node_modules/
# 仓库根只有 devDependencies（sharp，供 gen-brand 栅格化图标用），
# 前后端各自在 server/ 与 web/ 下有 lock，根锁不入库
/package-lock.json

# ---- server：没有构建步骤，只有运行时数据 ----
server/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ---- web：Vite 生产构建产物 ----
# ⚠ web/public/*.png 是 gen-brand 从 SVG 母版栅格化的**源资产**（要入库），
#   只有 dist/ 才是产物。
web/dist/
web/.vite/
web/coverage/

# ---- android：Gradle 与打包产物（端已冻结，保留构建能力）----
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/local.properties
android/**/*.apk
android/**/*.aab
/app/

# ---- ios：SwiftUI 原生端（ios/SuenMoney/）----
# 源码与 UI 测试全部入库；只有 Xcode 的本地索引/构建产物忽略。
ios/App/build/
ios/App/Pods/
ios/**/xcuserdata/
# SPM 迷你 workspace 索引由 Xcode 打开时自动生成，不入库；
# 但 xcshareddata/swiftpm/Package.resolved（iOS 依赖锁）必须跟踪，别整目录忽略
ios/**/*.xcworkspace/contents.xcworkspacedata
ios/**/*.ipa
ios/**/*.xcarchive
# Capacitor 时代 Web 静态产物（ios/App/App/public 由 sync 生成，不手写）
ios/App/App/public/

# ---- hw：Capacitor/WebView 时代的历史鸿蒙端（hw/，已冻结）----
hw/.hvigor/
hw/.idea/
hw/oh_modules/
hw/build/
hw/entry/build/
hw/local.properties
hw/**/*.hap
hw/**/*.hsp
hw/**/*.har
hw/entry/src/main/resources/rawfile/

# ---- hw-native：鸿蒙 NEXT 原生端（ArkTS，2.0 主线）----
hw-native/.hvigor/
hw-native/.idea/
hw-native/oh_modules/
hw-native/build/
hw-native/entry/build/
hw-native/entry/oh_modules/
hw-native/entry/.preview/
hw-native/local.properties
hw-native/**/*.hap
hw-native/**/*.hsp
hw-native/**/*.har
hw-native/**/src/main/resources/rawfile/
hw-native/.cxx/

# ---- fn：飞牛 fnOS 套件 ----
# fn/manifest、cmd/、config/、wizard/、ICON*.PNG 是**套件源**（入库）；
# 下面这些是 build-fn.mjs 装配出来的 payload，每次重建。
fn/app/bin/
fn/app/server/
fn/app/web/
fn/*.fpk
fn/app.tgz
output/

# ---- 品牌渲染产物：由 npm run icons 从矢量母版重新生成 ----
docs/design/brand/dist/

# ---- 通用 ----
*.log
.DS_Store
Thumbs.db

# ---- 本地环境变量 ----
.env
.env.local
.env.*.local

# ---- 私人数据（绝不入库）----
# 备份/导出文件含全部账单，只存在于本地 output/
/*.csv
/backup*.json
/suenmoney-backup*.json

# ---- 工具产生的临时目录 ----
.dsh-vision-router/
.vscode/
.idea/
*.swp
