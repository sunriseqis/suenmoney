# 复制为 .env 后按需修改。所有项都有安全的内置默认值。

# HTTP 监听端口
SUENMONEY_PORT=3310

# SQLite 库文件路径（目录会自动创建）
SUENMONEY_DB_PATH=./data/suenmoney.sqlite

# 允许跨域的来源，逗号分隔；开发时给 Vite 用。留空 = 允许同源与 localhost
SUENMONEY_CORS_ORIGINS=http://localhost:5310

# 会话令牌有效期（天）
SUENMONEY_SESSION_DAYS=180

# 是否允许自助注册。默认 false：账号只能由管理员在 Web 后台创建
SUENMONEY_ALLOW_REGISTRATION=false

# 备份目录与保留份数
SUENMONEY_BACKUP_DIR=./data/backups
SUENMONEY_BACKUP_KEEP=14
